#compdef key-modifier
# Rename this file to match your binary's actual name (the file name after
# the leading underscore must equal what you type at the prompt), and
# replace `key-modifier` below with that same name.
#
# Install by putting this file in a directory that's in your $fpath, e.g.:
#   mkdir -p ~/.zsh/completions
#   cp _key-modifier ~/.zsh/completions/
#   # in ~/.zshrc, before `compinit` runs:
#   fpath=(~/.zsh/completions $fpath)
# Then start a new shell (or `autoload -Uz compinit && compinit`).

_key-modifier() {
  local -a typed_args completions

  # Extract only the fully completed words (index 2 to CURRENT-1).
  # This correctly handles mid-word tabs (like -) and completed keys (like \').
  typed_args=("${(@)words[2,CURRENT-1]}")

  # Ask the program what can come next based ONLY on previous full arguments.
  completions=("${(@f)$(command key-modifier __complete "${typed_args[@]}")}")

  # Nothing to complete.
  (( ${#completions[@]} )) || return 0

  # Let zsh perform prefix filtering against the current word.
  compadd -- "${completions[@]}"
}

_key-modifier "$@"
