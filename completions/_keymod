#compdef key-modifier

# Zsh completion for key-modifier.

_keymod_keys() {
  local -a keys

  keys=(${(f)"$(key-modifier --list-keys 2>/dev/null)"})

  if (( ${#keys} == 0 )); then
    _message 'key name'
    return 1
  fi

  compadd -a keys
}

_keymod_durations() {
  _message 'duration (e.g. 10ms, 1s, 250us)'
}

_keymod_device_id() {
  _message 'device id'
}

_keymod_modify_state() {
  local -a clause used remaining
  local start=-1
  local i j tok o

  # Find the most recent --modify.
  for (( i = 1; i < CURRENT; i++ )); do
    if [[ ${words[i]} == --modify ]]; then
      start=$i
    fi
  done

  (( start >= 0 )) || return 1

  # Everything after --modify and before the current word.
  clause=("${(@)words[start+1,CURRENT-1]}")

  # First argument is the source key.
  if (( ${#clause} == 0 )); then
    _keymod_keys
    return
  fi

  shift clause

  # Optional "to".
  if [[ ${clause[1]} == to ]]; then
    shift clause
  fi

  # No modifiers yet: suggest them.
  if (( ${#clause} == 0 )); then
    compadd -- \
      from \
      invert \
      replace \
      toggle \
      turbo \
      delay \
      maxPressTime \
      minPressTime
    return
  fi

  j=1

  while (( j <= ${#clause} )); do
    tok=${clause[j]}

    case "$tok" in
      from)
        used+=(from)

        if (( j == ${#clause} )); then
            _keymod_device_id
            return
        fi

        (( j += 2 ))
        ;;

      invert|toggle)
        used+=("$tok")
        (( j++ ))
        ;;

      replace)
        used+=(replace)

        # replace <key>
        if (( j == ${#clause} )); then
            _keymod_keys
            return
        fi

        (( j += 2 ))

        # Optional: from <device>
        if (( j <= ${#clause} && ${clause[j]} == from )); then
            used+=(from)

            if (( j == ${#clause} )); then
                _keymod_device_id
                return
            fi

            (( j += 2 ))
        fi
        ;;

      turbo)
        used+=(turbo)
        (( j++ ))

        while (( j <= ${#clause} &&
            ( ${clause[j]} == downFor ||
              ${clause[j]} == delay ) )); do

            if (( j == ${#clause} )); then
                _keymod_durations
                return
            fi

            (( j += 2 ))
        done
        ;;

      delay)
        used+=(delay)
        (( j++ ))

        while (( j <= ${#clause} &&
            ( ${clause[j]} == down ||
              ${clause[j]} == up ) )); do

            if (( j == ${#clause} )); then
                _keymod_durations
                return
            fi

            (( j += 2 ))
        done
        ;;

      maxPressTime|minPressTime)
        used+=("$tok")

        if (( j == ${#clause} )); then
            _keymod_durations
            return
        fi

        (( j += 2 ))
        ;;

      *)
        (( j++ ))
        ;;
    esac
  done

  local -a opts=(
    from
    invert
    replace
    toggle
    turbo
    delay
    maxPressTime
    minPressTime
  )

  for o in "${opts[@]}"; do
    if (( ! ${used[(Ie)$o]} )); then
      remaining+=("$o")
    fi
  done

  compadd -- "${remaining[@]}"
}

_keymod() {
  # First argument: offer top-level options.
  if (( CURRENT == 1 )); then
    compadd -- \
      --modify # \
      # --list-keys
    return
  fi

  # Immediately after --modify => key name.
  if [[ ${words[CURRENT-1]} == --modify ]]; then
    _keymod_keys
    return
  fi

  # If we're inside a --modify clause, handle it.
  local i

  for (( i = CURRENT - 1; i >= 1; i-- )); do
    if [[ ${words[i]} == --modify ]]; then
      _keymod_modify_state
      return
    fi

    # Another top-level option means we're no longer in --modify.
    if [[ ${words[i]} == --* ]]; then
      break
    fi
  done

  compadd -- --modify # --list-keys
}

_keymod "$@"
